diff -ruN a/src/dataengines/mouse/cursornotificationhandler.cpp b/src/dataengines/mouse/cursornotificationhandler.cpp
--- a/src/dataengines/mouse/cursornotificationhandler.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/src/dataengines/mouse/cursornotificationhandler.cpp	2026-10-21 23:47:02.289395626 +0200
@@ -0,0 +1,119 @@
+/*
+    SPDX-FileCopyrightText: 2007 Fredrik Höglund <fredrik@kde.org>
+
+    SPDX-License-Identifier: LGPL-2.0-only
+*/
+
+#include "cursornotificationhandler.h"
+
+#include <QGuiApplication>
+#include <QNativeInterface>
+
+#include <X11/extensions/Xfixes.h>
+#include <xcb/xfixes.h>
+
+/*
+ * This class is a QWidget because we need an X window to
+ * be able to receive XFixes events. We don't actually map
+ * the widget. Qt 6 delivers those events as xcb generic events.
+ */
+
+CursorNotificationHandler::CursorNotificationHandler()
+    : QWidget()
+{
+    auto *x11App = qGuiApp->nativeInterface<QNativeInterface::QX11Application>();
+    Display *dpy = x11App ? x11App->display() : nullptr;
+    if (!dpy) {
+        return;
+    }
+
+    int errorBase = 0;
+
+    // Request cursor change notification events
+    if (XFixesQueryExtension(dpy, &fixesEventBase, &errorBase)) {
+        int major = 0;
+        int minor = 0;
+        XFixesQueryVersion(dpy, &major, &minor);
+
+        if (major >= 2) {
+            XFixesSelectCursorInput(dpy, winId(), XFixesDisplayCursorNotifyMask);
+            XFlush(dpy);
+            haveXfixes = true;
+        }
+    }
+}
+
+CursorNotificationHandler::~CursorNotificationHandler()
+{
+}
+
+QString CursorNotificationHandler::cursorName()
+{
+    if (!haveXfixes) {
+        return QString();
+    }
+
+    if (!currentName) {
+        auto *x11App = qGuiApp->nativeInterface<QNativeInterface::QX11Application>();
+        Display *dpy = x11App ? x11App->display() : nullptr;
+        if (!dpy) {
+            return QString();
+        }
+        // Xfixes doesn't have a request for getting the current cursor name,
+        // but it's included in the XFixesCursorImage struct.
+        XFixesCursorImage *image = XFixesGetCursorImage(dpy);
+        if (!image) {
+            return QString();
+        }
+        currentName = image->atom;
+        XFree(image);
+    }
+
+    return cursorName(currentName);
+}
+
+QString CursorNotificationHandler::cursorName(unsigned long cursor)
+{
+    QString name;
+
+    // XGetAtomName() is a synchronous call, so we cache the name
+    // in an atom<->string map the first time we see a name
+    // to keep the X server round trips down.
+    if (names.contains(cursor)) {
+        name = names[cursor];
+    } else {
+        auto *x11App = qGuiApp->nativeInterface<QNativeInterface::QX11Application>();
+        Display *dpy = x11App ? x11App->display() : nullptr;
+        if (!dpy) {
+            return QString();
+        }
+        char *data = XGetAtomName(dpy, cursor);
+        if (!data) {
+            return QString();
+        }
+        name = QString::fromUtf8(data);
+        XFree(data);
+
+        names.insert(cursor, name);
+    }
+
+    return name;
+}
+
+bool CursorNotificationHandler::nativeEvent(const QByteArray &eventType, void *message, qintptr *result)
+{
+    Q_UNUSED(result);
+    if (!haveXfixes || eventType != "xcb_generic_event_t" || !message) {
+        return false;
+    }
+
+    const auto *event = static_cast<const xcb_generic_event_t *>(message);
+    if ((event->response_type & 0x7f) != fixesEventBase + XCB_XFIXES_CURSOR_NOTIFY) {
+        return false;
+    }
+
+    const auto *notify = reinterpret_cast<const xcb_xfixes_cursor_notify_event_t *>(event);
+    currentName = notify->name;
+    Q_EMIT cursorNameChanged(cursorName(currentName));
+    return false;
+}
diff -ruN a/src/dataengines/mouse/cursornotificationhandler.h b/src/dataengines/mouse/cursornotificationhandler.h
--- a/src/dataengines/mouse/cursornotificationhandler.h	1970-01-01 01:00:00.000000000 +0100
+++ b/src/dataengines/mouse/cursornotificationhandler.h	2026-10-21 23:46:54.166742714 +0200
@@ -0,0 +1,38 @@
+/*
+    SPDX-FileCopyrightText: 2007 Fredrik Höglund <fredrik@kde.org>
+
+    SPDX-License-Identifier: LGPL-2.0-only
+*/
+
+#pragma once
+
+#include <QMap>
+#include <QWidget>
+
+#include <X11/Xlib.h>
+#include <fixx11h.h>
+
+class CursorNotificationHandler : public QWidget
+{
+    Q_OBJECT
+
+public:
+    CursorNotificationHandler();
+    ~CursorNotificationHandler() override;
+
+    QString cursorName();
+
+Q_SIGNALS:
+    void cursorNameChanged(const QString &name);
+
+protected:
+    bool nativeEvent(const QByteArray &eventType, void *message, qintptr *result) override;
+
+private:
+    QString cursorName(unsigned long cursor);
+
+    bool haveXfixes = false;
+    int fixesEventBase = 0;
+    unsigned long currentName = 0;
+    QMap<unsigned long, QString> names;
+};
